@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI {
interface Ui
abstract class "UiPart<T>" as UiPart
class UiManager
class MainWindow
class CommandBox
interface "CommandBox.CommandExecutor" as CommandExecutor
class ResultDisplay
class StatusBarFooter
class ClientListPanel
class ClientCard
class PetListPanel
class PetCard
class AppointmentListPanel
class AppointmentCard
}
package Logic {
interface "Logic" as LogicApi LOGIC_COLOR
}
package Model {
class Client MODEL_COLOR
class Pet MODEL_COLOR
class Appointment MODEL_COLOR
}
UiManager ..|> Ui
UiManager --> "0..1" MainWindow
UiManager --> "1" LogicApi
MainWindow --> "1" LogicApi
CommandBox --> "1" CommandExecutor
MainWindow ..> CommandExecutor : supplies callback
MainWindow *--> "1" CommandBox
MainWindow *--> "1" ResultDisplay
MainWindow *--> "1" StatusBarFooter
MainWindow *--> "1" ClientListPanel
MainWindow *--> "1" PetListPanel
MainWindow *--> "1" AppointmentListPanel
MainWindow --|> UiPart
CommandBox --|> UiPart
ResultDisplay --|> UiPart
StatusBarFooter --|> UiPart
ClientListPanel --|> UiPart
PetListPanel --|> UiPart
AppointmentListPanel --|> UiPart
ClientCard --|> UiPart
PetCard --|> UiPart
AppointmentCard --|> UiPart
ClientListPanel ..> ClientCard : creates via cells
ClientListPanel ..> Client : displays observable list
ClientCard --> "1" Client
PetListPanel ..> PetCard : creates via cells
PetListPanel ..> Pet : displays observable list
PetCard --> "1" Pet
AppointmentListPanel ..> AppointmentCard : creates via cells
AppointmentListPanel ..> Appointment : displays observable list
AppointmentCard --> "1" Appointment
@enduml
